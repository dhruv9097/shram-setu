# ---------------------------------------------------------------- database
# Local development uses SQLite — no setup, no network, fast reseeds.
DATABASE_URL="file:./dev.db"

# For the deployed build, swap to the Neon Postgres pooled connection string
# and run `npm run db:pg`. Looks like:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------ gemini
# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship the key
# to the browser. Powers the multilingual voice-intent layer; the app degrades
# to a scripted demo path if this is absent.
GEMINI_API_KEY=""
